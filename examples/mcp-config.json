{
  "mcpServers": {
    "unity": {
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "<repository-root>/server/UnityMcpServer/UnityMcpServer.csproj"
      ],
      "env": {
        "UNITY_MCP_BRIDGE_URL": "http://127.0.0.1:8765",
        "UNITY_MCP_UNITY_PATH": "<unity-editor-installation>/Editor/<version>/Editor/Unity.exe"
      }
    }
  }
}
